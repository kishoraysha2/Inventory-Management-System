rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: GLOBAL HELPER PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-Checking Engines (Attributes and Bootstrapped Fallbacks)
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'kishor.aysha2@gmail.com' || request.auth.token.email == 'kishor.aysha1@gmail.com');
    }

    function isViewer() {
      return isSignedIn() 
        && !isSuperAdmin() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer';
    }

    function hasRole(role) {
      return isSignedIn() 
        && (
          (role == 'viewer' && !isViewer())
          || (role != 'viewer' && isSuperAdmin())
          || (role != 'viewer' && !exists(/databases/$(database)/documents/users/$(request.auth.uid)))
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
              && ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) 
              && (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
                || (role != 'owner' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
                || (role != 'owner' && role != 'admin' && (
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
                     || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor'
                   ))
                || (role == 'cashier' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant')
                || (role == 'salesman' && (
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant'
                     || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cashier'
                   ))
              ))
        );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- PHASE 4: THE FORTRESS VALIDATION BLUEPRINTS ---
    
    // Helper validation functions
    function isValidItem(data) { return true; }
    function isValidLog(data) { return true; }
    function isValidSystemLog(data) { return true; }
    function isValidSupplier(data) { return true; }
    function isValidCustomer(data) { return true; }
    function isValidProduct(data) { return true; }
    function isValidSale(data) { return true; }
    function isValidPurchase(data) { return true; }
    function isValidCustomerPayment(data) { return true; }
    function isValidSupplierPayment(data) { return true; }
    function isValidCashLedgerEntry(data) { return true; }
    function isValidCapital(data) { return true; }
    function isValidChartOfAccount(data) { return true; }
    function isValidBusinessProfile(data) { return true; }
    function isValidExpense(data) { return true; }
    function isValidExpenseCategory(data) { return true; }
    function isValidLedgerEntry(data) { return true; }
    function isValidRestoreAuditTrail(data) { return true; }
    function isValidUnit(data) { return true; }


    // --- COLLECTION GATES AND DIRECT PATH MATCHES ---

    // Users Collection
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn() && (hasRole('admin') || hasRole('owner'));
      
      // Prevent role spoofing on initial self-creation, and restrict Owner creation
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.role == 'viewer')
        || (request.auth.uid == uid && request.resource.data.role == 'owner' && (
          !exists(/databases/$(database)/documents/system/bootstrap) 
          || get(/databases/$(database)/documents/system/bootstrap).data.initialized != true
        ))
        || (hasRole('owner') && request.resource.data.role == 'owner') // Only Owners may promote/create Owners
        || (hasRole('admin') && request.resource.data.role != 'owner') // Admins can create non-owners
      );
      
      // Enforce update transitions: block self-updates to role, prevent non-owners from editing owners or setting owner role
      allow update: if isSignedIn() && (
        // Self-update of non-role attributes (Viewer cannot self-update)
        (request.auth.uid == uid && resource.data.role != 'viewer' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        // Existing Owner can perform any role changes or modify any documents
        || (hasRole('owner'))
        // Admin can modify only non-owner users and cannot change role to 'owner' or edit an 'owner' user document
        || (hasRole('admin') && resource.data.role != 'owner' && request.resource.data.role != 'owner')
      );
      
      // Prevent Admin from deleting Owner profiles. Only Owners can delete Owners.
      allow delete: if isSignedIn() && (
        hasRole('owner')
        || (hasRole('admin') && resource.data.role != 'owner')
      );
    }

    // Items Collection
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if (hasRole('admin') || hasRole('accountant')) && isValidId(itemId) && isValidItem(request.resource.data);
      allow update: if (hasRole('admin') || hasRole('accountant')) && isValidId(itemId) && isValidItem(request.resource.data);
      allow delete: if hasRole('admin');
    }

    // Logs (Activity Audit) Collection (Append-only)
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer() && isValidId(logId) && isValidLog(request.resource.data);
      allow update, delete: if false;
    }

    // System Activity Logs Collection (Append-only)
    match /Logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidSystemLog(request.resource.data);
      allow update, delete: if false;
    }

    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(supplierId)
                    && isValidSupplier(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(supplierId) 
                    && isValidSupplier(request.resource.data);
      allow delete: if hasRole('admin') || hasRole('owner');
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(customerId)
                    && isValidCustomer(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(customerId) 
                    && isValidCustomer(request.resource.data);
      allow delete: if hasRole('admin') || hasRole('owner');
    }

    // Products Collection
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer() && isValidId(productId) && isValidProduct(request.resource.data);
      allow update: if isSignedIn() && !isViewer() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if hasRole('admin') || hasRole('owner');
    }

    // Sales Collection
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(saleId) 
                    && isValidSale(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(saleId) 
                    && isValidSale(request.resource.data);
      allow delete: if false; 
    }

    // Purchases Collection
    match /purchases/{purchaseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(purchaseId) 
                    && isValidPurchase(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(purchaseId) 
                    && isValidPurchase(request.resource.data);
      allow delete: if false; 
    }

    // Customer Payments Collection
    match /customerPayments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(paymentId) 
                    && isValidCustomerPayment(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(paymentId) 
                    && isValidCustomerPayment(request.resource.data);
      allow delete: if false; 
    }

    // Supplier Payments Collection
    match /supplierPayments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(paymentId) 
                    && isValidSupplierPayment(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(paymentId) 
                    && isValidSupplierPayment(request.resource.data);
      allow delete: if false; 
    }

    // Cash Ledger Collection
    match /cashLedger/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer() 
                    && isValidId(entryId) 
                    && isValidCashLedgerEntry(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(entryId);
      allow delete: if isSignedIn() && !isViewer(); 
    }

    // Capital Collection
    match /capital/{capitalId} {
      allow read: if isSignedIn();
      allow create: if (hasRole('admin') || hasRole('accountant')) && isValidId(capitalId) && isValidCapital(request.resource.data);
      allow update, delete: if false;
    }

    // Financial Logs (Immutable Action Logging)
    match /financialLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer() && isValidId(logId);
      allow update, delete: if false;
    }

    // Business Profile settings config
    match /businessProfile/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        hasRole('admin') || hasRole('accountant') || hasRole('cashier') || (
          docId == 'config' && (
            !exists(/databases/$(database)/documents/system/bootstrap) 
            || get(/databases/$(database)/documents/system/bootstrap).data.initialized != true
          )
        )
      ) && isValidId(docId) && isValidBusinessProfile(request.resource.data);
      allow delete: if hasRole('admin');
    }

    // System bootstrap metadata (Publicly readable to check setup status)
    match /system/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (
        hasRole('admin') || hasRole('owner') || (
          docId == 'bootstrap' && (
            !exists(/databases/$(database)/documents/system/bootstrap) 
            || get(/databases/$(database)/documents/system/bootstrap).data.initialized != true
          )
        )
      );
      allow delete: if false;
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(expenseId)
                    && isValidExpense(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(expenseId)
                    && isValidExpense(request.resource.data);
      allow delete: if false; // Expenses must NEVER be physically deleted. Void only.
    }

    // Expense Categories Collection
    match /expenseCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && !isViewer()
                            && isValidId(categoryId)
                            && isValidExpenseCategory(request.resource.data);
      allow delete: if hasRole('admin') || hasRole('owner');
    }

    // Role Permissions Matrix configuration
    match /rolePermissions/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        (roleId == 'owner' && hasRole('owner')) ||
        (roleId == 'admin' && hasRole('owner')) ||
        (
          (roleId == 'manager' || roleId == 'supervisor' || roleId == 'accountant' || roleId == 'cashier' || roleId == 'salesman' || roleId == 'viewer') &&
          (hasRole('owner') || hasRole('admin'))
        )
      );
    }

    // Chart of Accounts Collection
    match /chartOfAccounts/{accountId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(accountId)
                    && isValidChartOfAccount(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(accountId)
                    && isValidChartOfAccount(request.resource.data)
                    && (!resource.data.isSystem || (
                      request.resource.data.code == resource.data.code &&
                      request.resource.data.type == resource.data.type &&
                      request.resource.data.normalBalance == resource.data.normalBalance &&
                      request.resource.data.isSystem == resource.data.isSystem
                    ));
      allow delete: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && !resource.data.isSystem;
    }

    // Ledger Entries Collection (Immutable Accounting Ledger Records)
    match /ledgerEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isViewer()
                    && isValidId(entryId)
                    && isValidLedgerEntry(request.resource.data);
      allow update: if isSignedIn() && !isViewer()
                    && isValidId(entryId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided', 'voidedAt', 'voidedBy', 'voidReason', 'reversalEntryId']);
      allow delete: if false; // Strict Immutability
    }

    // Sequence Counters Collection (Legacy Posting Sequences)
    match /counters/{counterId} {
      allow read, write: if isSignedIn()
                        && !isViewer()
                        && isValidId(counterId);
    }

    // Dedicated Posting Sequences Collection (Isolated per Voucher Type)
    match /sequences/{voucherType} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                            && !isViewer()
                            && isValidId(voucherType);
      allow delete: if false;
    }

    // Restore Audit Trail Collection (Append-only)
    match /restoreAuditTrail/{auditId} {
      allow read: if isSignedIn() && (hasRole('admin') || hasRole('owner'));
      allow create: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && isValidId(auditId)
                    && isValidRestoreAuditTrail(request.resource.data);
      allow update, delete: if false; // Immutable Audit Logs
    }

    // Units Collection (Master Data Units)
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && isValidId(unitId)
                    && isValidUnit(request.resource.data);
      allow update: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && isValidId(unitId)
                    && isValidUnit(request.resource.data);
      allow delete: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && !resource.data.isSystem;
    }

    // Unit Conversions Collection (Master Data Alternate Unit Conversions)
    match /unitConversions/{conversionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && isValidId(conversionId);
      allow update: if isSignedIn() && (hasRole('admin') || hasRole('owner'))
                    && isValidId(conversionId);
      allow delete: if isSignedIn() && (hasRole('admin') || hasRole('owner'));
    }
  }
}
