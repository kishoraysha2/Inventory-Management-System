{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "An item in the inventory catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "minQuantity": { "type": "number" },
        "supplierName": { "type": "string" },
        "supplierEmail": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "name", "sku", "category", "price", "quantity", "minQuantity"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Log of stock activity or changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string", "enum": ["add", "edit", "delete", "stock_change"] },
        "description": { "type": "string" },
        "quantityDifference": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "type", "description", "timestamp"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "A system activity log entry tracking core operations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "user": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "user", "timestamp", "details"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier accounts with trade terms and record-keeping properties.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["Cash", "Credit"] },
        "dueBalance": { "type": "number" },
        "createdDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "phone"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record with trade/credit terms and balance tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "customerType": { "type": "string", "enum": ["Cash", "Credit"] },
        "dueBalance": { "type": "number" },
        "createdDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "phone", "address", "customerType", "dueBalance", "createdDate"]
    },
    "Product": {
      "title": "Product",
      "description": "A manufactured, ordered, or distributed stock unit with distinct custom specs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minimumStockAlert": { "type": "number" },
        "createdDate": { "type": "string" }
      },
      "required": ["id", "name", "sku", "category", "purchasePrice", "sellingPrice", "currentStock", "minimumStockAlert"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A ledger record tracking product sales to customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "unitPrice": { "type": "number" },
        "subtotal": { "type": "number" },
        "taxRatePercent": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["Cash", "Credit"] },
        "saleDate": { "type": "string" },
        "timestamp": { "type": "string" },
        "productPurchasePriceAtSale": { "type": "number" },
        "productSellingPriceAtSale": { "type": "number" },
        "costOfGoodsSold": { "type": "number" },
        "grossProfit": { "type": "number" }
      },
      "required": ["id", "customerId", "customerName", "productId", "productName", "quantity", "sellingPrice", "unitPrice", "subtotal", "taxRatePercent", "taxAmount", "totalAmount", "paymentType", "saleDate", "timestamp"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A ledger record tracking product purchases from suppliers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["Cash", "Credit"] },
        "purchaseDate": { "type": "string" }
      },
      "required": ["id", "supplierId", "supplierName", "productId", "productName", "quantity", "purchasePrice", "totalAmount", "paymentType", "purchaseDate"]
    },
    "CustomerPayment": {
      "title": "CustomerPayment",
      "description": "A ledger record tracking customer's due payments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "amountPaid": { "type": "number" },
        "previousDue": { "type": "number" },
        "remainingDue": { "type": "number" },
        "paymentDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "customerId", "amountPaid", "previousDue", "remainingDue", "paymentDate"]
    },
    "SupplierPayment": {
      "title": "SupplierPayment",
      "description": "A ledger record tracking supplier default/due payments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "amountPaid": { "type": "number" },
        "previousDue": { "type": "number" },
        "remainingDue": { "type": "number" },
        "paymentDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "supplierId", "amountPaid", "previousDue", "remainingDue", "paymentDate"]
    },
    "CashLedgerEntry": {
      "title": "CashLedgerEntry",
      "description": "A ledger record tracking real cash inflows and outflows in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["inflow", "outflow"] },
        "source": { "type": "string", "enum": ["sale", "purchase", "payment", "manual"] },
        "amount": { "type": "number" },
        "referenceId": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "type", "source", "amount", "description", "timestamp"]
    },
    "Capital": {
      "title": "Capital",
      "description": "An investment or capital entry made into the business.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "amount", "date", "createdBy"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "accountant", "cashier", "viewer"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles tracking Role-Based Access Control permissions."
    },
    "items": {
      "schema": "InventoryItem",
      "description": "Store all inventory items."
    },
    "logs": {
      "schema": "ActivityLog",
      "description": "Store system audit logs."
    },
    "Logs": {
      "schema": "SystemLog",
      "description": "Store the new complete system activity logs."
    },
    "suppliers": {
      "schema": "Supplier",
      "description": "Store supplier details."
    },
    "customers": {
      "schema": "Customer",
      "description": "Store customer accounts."
    },
    "products": {
      "schema": "Product",
      "description": "Store product management records."
    },
    "sales": {
      "schema": "Sale",
      "description": "Store sale transactions and records."
    },
    "purchases": {
      "schema": "Purchase",
      "description": "Store purchase transactions and records from suppliers."
    },
    "customerPayments": {
      "schema": "CustomerPayment",
      "description": "Store customer payment ledger entries."
    },
    "supplierPayments": {
      "schema": "SupplierPayment",
      "description": "Store supplier payment ledger entries."
    },
    "cashLedger": {
      "schema": "CashLedgerEntry",
      "description": "Store cash ledger transaction entries."
    },
    "capital": {
      "schema": "Capital",
      "description": "Store initial business capital investments."
    }
  }
}
