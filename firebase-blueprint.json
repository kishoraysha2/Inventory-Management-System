{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "An item in the inventory catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "minQuantity": { "type": "number" },
        "supplierName": { "type": "string" },
        "supplierEmail": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "name", "sku", "category", "price", "quantity", "minQuantity"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Log of stock activity or changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string", "enum": ["add", "edit", "delete", "stock_change"] },
        "description": { "type": "string" },
        "quantityDifference": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "type", "description", "timestamp"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "A system activity log entry tracking core operations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "user": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "user", "timestamp", "details"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier accounts with trade terms and record-keeping properties.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["Cash", "Credit"] },
        "dueBalance": { "type": "number" },
        "createdDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "phone"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record with trade/credit terms and balance tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "customerType": { "type": "string", "enum": ["Cash", "Credit"] },
        "dueBalance": { "type": "number" },
        "createdDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "vatNumber": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "name", "phone", "address", "customerType", "dueBalance", "createdDate"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Centralized corporate configurations and issuer tax settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tradeName": { "type": "string" },
        "ownerName": { "type": "string" },
        "taxRegistrationId": { "type": "string" },
        "crNumber": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "logo": { "type": "string" },
        "taxRatePercent": { "type": "number" }
      },
      "required": ["name", "taxRegistrationId", "address", "phone"]
    },
    "Product": {
      "title": "Product",
      "description": "A manufactured, ordered, or distributed stock unit with distinct custom specs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minimumStockAlert": { "type": "number" },
        "createdDate": { "type": "string" }
      },
      "required": ["id", "name", "sku", "category", "purchasePrice", "sellingPrice", "currentStock", "minimumStockAlert"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A ledger record tracking product sales to customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "unitPrice": { "type": "number" },
        "subtotal": { "type": "number" },
        "taxRatePercent": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["Cash", "Credit"] },
        "saleDate": { "type": "string" },
        "timestamp": { "type": "string" },
        "productPurchasePriceAtSale": { "type": "number" },
        "productSellingPriceAtSale": { "type": "number" },
        "costOfGoodsSold": { "type": "number" },
        "grossProfit": { "type": "number" },
        "invoiceNumber": { "type": "string" },
        "customerSnapshot": { "type": "object" },
        "companySnapshot": { "type": "object" }
      },
      "required": ["id", "customerId", "customerName", "productId", "productName", "quantity", "sellingPrice", "unitPrice", "subtotal", "taxRatePercent", "taxAmount", "totalAmount", "paymentType", "saleDate", "timestamp"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A ledger record tracking product purchases from suppliers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["Cash", "Credit"] },
        "purchaseDate": { "type": "string" }
      },
      "required": ["id", "supplierId", "supplierName", "productId", "productName", "quantity", "purchasePrice", "totalAmount", "paymentType", "purchaseDate"]
    },
    "CustomerPayment": {
      "title": "CustomerPayment",
      "description": "A ledger record tracking customer's due payments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "amountPaid": { "type": "number" },
        "previousDue": { "type": "number" },
        "remainingDue": { "type": "number" },
        "paymentDate": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "receiptDate": { "type": "string" },
        "receivedBy": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "chequeOrBankRef": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerId", "amountPaid", "previousDue", "remainingDue", "paymentDate", "receiptNumber", "receiptDate", "receivedBy"]
    },
    "SupplierPayment": {
      "title": "SupplierPayment",
      "description": "A ledger record tracking supplier default/due payments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "amountPaid": { "type": "number" },
        "previousDue": { "type": "number" },
        "remainingDue": { "type": "number" },
        "paymentDate": { "type": "string" },
        "voucherNumber": { "type": "string" },
        "paidBy": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "chequeOrBankRef": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "supplierId", "amountPaid", "previousDue", "remainingDue", "paymentDate", "voucherNumber", "paidBy"]
    },
    "CashLedgerEntry": {
      "title": "CashLedgerEntry",
      "description": "A ledger record tracking real cash inflows and outflows in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["inflow", "outflow"] },
        "source": { "type": "string", "enum": ["sale", "purchase", "payment", "manual"] },
        "amount": { "type": "number" },
        "referenceId": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "type", "source", "amount", "description", "timestamp"]
    },
    "Capital": {
      "title": "Capital",
      "description": "An investment or capital entry made into the business.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "amount", "date", "createdBy"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "accountant", "cashier", "viewer"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "RolePermission": {
      "title": "RolePermission",
      "description": "Configuration tracking dynamic privilege matrix configurations per role.",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "privileges": {
          "type": "object",
          "description": "AppPermissions mapping booleans."
        },
        "lastUpdatedBy": { "type": "string" },
        "lastUpdatedTime": { "type": "string" }
      },
      "required": ["role", "privileges", "lastUpdatedBy", "lastUpdatedTime"]
    },
    "Expense": {
      "title": "Expense",
      "description": "An expense recorded in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "expenseNumber": { "type": "string" },
        "expenseDate": { "type": "string" },
        "category": { "type": "string" },
        "vendor": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "void"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "expenseNumber", "expenseDate", "category", "vendor", "description", "amount", "paymentMethod", "referenceNumber", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "ExpenseCategory": {
      "title": "ExpenseCategory",
      "description": "A custom expense category.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "FinancialLog": {
      "title": "FinancialLog",
      "description": "A financial transaction or audit log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "referenceId": { "type": "string" },
        "performedBy": { "type": "string" },
        "userRole": { "type": "string" },
        "customerId": { "type": "string" },
        "supplierId": { "type": "string" },
        "productId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentType": { "type": "string" },
        "previousState": { "type": "string" },
        "newState": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "timestamp", "action", "entityType", "entityId", "performedBy", "userRole", "amount", "previousState", "newState"]
    },
    "ChartOfAccount": {
      "title": "ChartOfAccount",
      "description": "An account definition in the Chart of Accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Asset", "Liability", "Equity", "Revenue", "Expense"] },
        "subType": { "type": "string" },
        "parentAccount": { "type": "string" },
        "description": { "type": "string" },
        "normalBalance": { "type": "string", "enum": ["Debit", "Credit"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isSystem": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "type", "normalBalance", "status", "isSystem", "editable"]
    },
    "LedgerEntryLine": {
      "title": "LedgerEntryLine",
      "description": "An individual debit or credit line in a ledger entry.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "accountCode": { "type": "string" },
        "accountName": { "type": "string" },
        "debit": { "type": "number" },
        "credit": { "type": "number" },
        "baseCurrencyDebit": { "type": "number" },
        "baseCurrencyCredit": { "type": "number" }
      },
      "required": ["accountId", "accountCode", "accountName", "debit", "credit", "baseCurrencyDebit", "baseCurrencyCredit"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "An immutable double-entry ledger entry header with lines.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postingNumber": { "type": "string" },
        "companyId": { "type": "string" },
        "branchId": { "type": "string" },
        "fiscalYear": { "type": "integer" },
        "accountingPeriod": { "type": "string" },
        "sourceModule": { "type": "string", "enum": ["SALES", "PROCUREMENT", "EXPENSE", "CUSTOMER_PAYMENT", "SUPPLIER_PAYMENT", "CAPITAL", "OPENING_BALANCE", "STOCK_ADJUSTMENT", "MANUAL_JOURNAL", "YEAR_CLOSING", "SYSTEM"] },
        "postingStatus": { "type": "string", "enum": ["POSTED", "REVERSED", "PENDING", "FAILED", "LOCKED"] },
        "currency": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "baseCurrencyCode": { "type": "string" },
        "version": { "type": "integer" },
        "narration": { "type": "string" },
        "createdFrom": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "postingDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "originalEntryId": { "type": "string" },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/entities/LedgerEntryLine"
          }
        }
      },
      "required": ["id", "postingNumber", "companyId", "branchId", "fiscalYear", "accountingPeriod", "sourceModule", "postingStatus", "currency", "exchangeRate", "baseCurrencyCode", "version", "narration", "createdFrom", "approvalStatus", "postingDate", "createdAt", "createdBy", "lines"]
    },
    "RestoreAuditTrail": {
      "title": "RestoreAuditTrail",
      "description": "An append-only log entry tracking backup restoration results, durations, and metadata validation results.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "operatorUid": { "type": "string" },
        "operatorEmail": { "type": "string" },
        "operationType": { "type": "string" },
        "restoreMode": { "type": "string" },
        "affectedModules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "documentCounts": { "type": "integer" },
        "status": { "type": "string" },
        "duration": { "type": "integer" },
        "validationResult": { "type": "object" }
      },
      "required": ["id", "timestamp", "operatorUid", "operatorEmail", "operationType", "restoreMode", "affectedModules", "documentCounts", "status", "duration", "validationResult"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles tracking Role-Based Access Control permissions."
    },
    "items": {
      "schema": "InventoryItem",
      "description": "Store all inventory items."
    },
    "logs": {
      "schema": "ActivityLog",
      "description": "Store system audit logs."
    },
    "Logs": {
      "schema": "SystemLog",
      "description": "Store the new complete system activity logs."
    },
    "suppliers": {
      "schema": "Supplier",
      "description": "Store supplier details."
    },
    "customers": {
      "schema": "Customer",
      "description": "Store customer accounts."
    },
    "products": {
      "schema": "Product",
      "description": "Store product management records."
    },
    "sales": {
      "schema": "Sale",
      "description": "Store sale transactions and records."
    },
    "purchases": {
      "schema": "Purchase",
      "description": "Store purchase transactions and records from suppliers."
    },
    "customerPayments": {
      "schema": "CustomerPayment",
      "description": "Store customer payment ledger entries."
    },
    "supplierPayments": {
      "schema": "SupplierPayment",
      "description": "Store supplier payment ledger entries."
    },
    "cashLedger": {
      "schema": "CashLedgerEntry",
      "description": "Store cash ledger transaction entries."
    },
    "capital": {
      "schema": "Capital",
      "description": "Store initial business capital investments."
    },
    "businessProfile": {
      "schema": "BusinessProfile",
      "description": "Store the centralized company tax and profile settings."
    },
    "rolePermissions": {
      "schema": "RolePermission",
      "description": "Dynamic privileges associated with each role."
    },
    "expenses": {
      "schema": "Expense",
      "description": "Store financial expenditures and corporate receipts."
    },
    "expenseCategories": {
      "schema": "ExpenseCategory",
      "description": "Store custom business expense categories."
    },
    "financialLogs": {
      "schema": "FinancialLog",
      "description": "Store financial transaction and change history logs."
    },
    "chartOfAccounts": {
      "schema": "ChartOfAccount",
      "description": "Store account definitions for the Chart of Accounts."
    },
    "ledgerEntries": {
      "schema": "LedgerEntry",
      "description": "Store immutable double-entry accounting ledger records."
    },
    "restoreAuditTrail": {
      "schema": "RestoreAuditTrail",
      "description": "Store backup restoration result history and metadata verification status."
    }
  }
}
